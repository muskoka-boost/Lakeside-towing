---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import { business } from '../data/site';
---

<Layout
  title="Page not found | Lakeside Towing & Recovery"
  description="That page does not exist. If you need a tow in Orillia or the surrounding area, call (249) 385-5240 — answered 24 hours a day."
  noindex
>
  <section class="notfound">
    <div class="wrap center">
      <p class="code">404</p>
      <h1>This page took a wrong turn</h1>
      <hr class="rule" />
      <p class="lede" style="margin-inline:auto">
        The page you were looking for is not here. If you need a tow right now,
        the number below works whatever page you landed on.
      </p>
      <div class="nf-actions">
        <a href={business.phoneHref} class="btn btn-primary">
          <Icon name="phone" size={21} />
          {business.phoneDisplay}
        </a>
        <a href="/" class="btn btn-ghost-light">Back to home</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">Try one of these</p>
        <h2>Our services</h2>
        <hr class="rule" />
      </div>
      <div style="margin-top:2.25rem">
        <ServiceGrid />
      </div>
      <p class="more-links">
        <a href="/rates/">Rates</a>
        <a href="/service-areas/">Service areas</a>
        <a href="/about/">About us</a>
        <a href="/contact/">Contact</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .notfound {
    background:
      radial-gradient(900px 380px at 75% -10%, rgb(21 82 191 / 55%), transparent 62%),
      linear-gradient(165deg, var(--navy), var(--navy-deep));
    color: #fff;
    padding-block: clamp(3.5rem, 9vw, 6rem);
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 16vw, 9rem);
    font-weight: 700;
    line-height: 0.85;
    color: var(--red);
    margin: 0 0 0.5rem;
  }

  .notfound h1 {
    color: #fff;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .more-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .more-links a {
    color: var(--navy);
    text-decoration: none;
  }

  .more-links a:hover {
    color: var(--red);
    text-decoration: underline;
  }
</style>
