---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import RateTable from '../components/RateTable.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  business,
  addressLine,
  credentials,
  areas,
  allCommunities,
  generalFaqs,
  photoById,
} from '../data/site';
import { url } from '../lib/paths';

const title = '24/7 Towing in Orillia ON | Lakeside Towing & Recovery';
const description =
  'Local 24/7 tow truck service in Orillia, Ontario. Emergency towing, winch-outs, boosts, lockouts and fuel delivery. OPP approved. Call (249) 385-5240.';

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: generalFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout title={title} description={description} schema={[faqSchema]}>
  <!-- ============================================================ Hero -- -->
  <section class="hero">
    <picture class="hero-img">
      <source
        media="(max-width: 640px)"
        srcset={url('/media/hero-wrecker-daylight-800.webp')}
        type="image/webp"
      />
      <source
        media="(max-width: 1280px)"
        srcset={url('/media/hero-wrecker-daylight-1280.webp')}
        type="image/webp"
      />
      <source srcset={url('/media/hero-wrecker-daylight.webp')} type="image/webp" />
      <img
        src={url('/media/hero-wrecker-daylight.jpg')}
        alt={photoById('hero-wrecker-daylight')!.alt}
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="wrap hero-content">
      <ul class="hero-badges">
        <li class="badge-red"><Icon name="badge-check" size={15} /> OPP Approved</li>
        <li><Icon name="clock" size={15} /> Open 24/7</li>
        <li><Icon name="map-pin" size={15} /> Based in Orillia</li>
      </ul>

      <h1>
        <span class="h1-lead">24 Hour Towing</span>
        <span class="h1-accent">in Orillia &amp; Area</span>
      </h1>

      <p class="hero-tagline">&ldquo;{business.tagline}&rdquo;</p>

      <p class="hero-lede">
        Local tow trucks, a real person on the phone at any hour, and a price
        before we roll. Serving Orillia, Rama, Washago, Gravenhurst and the
        communities around Lake Couchiching.
      </p>

      <div class="hero-actions">
        <a href={business.phoneHref} class="btn btn-primary hero-call">
          <Icon name="phone" size={24} />
          {business.phoneDisplay}
        </a>
        <a href={url('/services/')} class="btn btn-ghost-light">What we do</a>
      </div>

      <p class="hero-foot">
        <Icon name="check" size={15} /> No membership needed &nbsp;·&nbsp;
        <Icon name="check" size={15} /> Price quoted up front &nbsp;·&nbsp;
        <Icon name="check" size={15} /> Licensed &amp; insured
      </p>
    </div>
  </section>

  <!-- ======================================================= Proof bar -- -->
  <section class="proof">
    <div class="wrap proof-inner">
      {
        credentials.map((c) => (
          <div class="proof-item">
            <Icon name="badge-check" size={22} />
            <div>
              <strong>{c.label}</strong>
              <span>{c.detail}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ======================================================== Services -- -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">What we do</p>
        <h2>Towing, recovery &amp; roadside</h2>
        <hr class="rule" />
        <p class="lede">
          Every service under one number. Whatever has gone wrong, it is very
          probably something we handle every week.
        </p>
      </div>
      <div style="margin-top:2.5rem">
        <ServiceGrid />
      </div>
    </div>
  </section>

  <!-- =========================================================== Rates -- -->
  <section class="section section-paper">
    <div class="wrap">
      <div class="rates-head">
        <div>
          <p class="eyebrow">Straight answers</p>
          <h2>What it typically costs</h2>
          <hr class="rule" />
          <p class="lede">
            No calculator, no ceiling rates, no surprises at the roadside. These
            are the numbers we actually quote — and you will hear a firm price on
            the phone before a truck is dispatched.
          </p>
          <a href={url('/rates/')} class="btn btn-navy" style="margin-top:.5rem">
            Full rate list
            <Icon name="arrow-right" size={19} />
          </a>
        </div>
        <div class="rates-table-wrap">
          <RateTable
            only={['in-town', 'out-of-town', 'winch-out', 'boost', 'lockout', 'fuel']}
            showDisclaimer={false}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================== Areas -- -->
  <section class="section">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">Where we go</p>
        <h2>Serving Orillia &amp; the lakes</h2>
        <hr class="rule" />
        <p class="lede">
          Our yard is on Norweld Dr in Orillia, so we are not dispatching from
          another city and hoping the traffic cooperates. Orillia is in town;
          everywhere else we go is priced as an out-of-town run.
        </p>
      </div>

      <ul class="area-cards grid grid-3" style="margin-top:2.5rem">
        {
          areas.map((a) => (
            <li>
              <a href={url(`/service-areas/${a.slug}/`)}>
                <Icon name="map-pin" size={20} />
                <div>
                  <strong>{a.name}</strong>
                  <span>{a.proximity}</span>
                </div>
                <Icon name="chevron-right" size={18} class="chev" />
              </a>
            </li>
          ))
        }
      </ul>

      <div class="area-more">
        <p>We also cover:</p>
        <ul class="chips">
          {
            allCommunities
              .filter((c) => !areas.some((a) => a.name === c))
              .map((c) => <li>{c}</li>)
          }
        </ul>
        <p class="area-note">
          Not on the list? <a href={business.phoneHref}>Call us</a> — we work
          this area rather than the whole province, but we will tell you
          straight away whether your job is one of ours.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================================================== About -- -->
  <section class="section section-navy">
    <div class="wrap why-grid">
      <div>
        <p class="eyebrow">Why Lakeside</p>
        <h2>A local truck, not a call centre</h2>
        <hr class="rule" />
        <p class="lede">
          Plenty of numbers you find online route to a dispatch service that
          sells your call to whoever is nearest. We are the truck. You are
          talking to the people who will actually turn up.
        </p>
      </div>
      <ul class="why-list">
        <li>
          <Icon name="phone" size={20} />
          <div>
            <strong>You get a price before we dispatch</strong>
            <p>
              The number you hear on the phone is the number on the invoice. No
              meter running while you decide.
            </p>
          </div>
        </li>
        <li>
          <Icon name="clock" size={20} />
          <div>
            <strong>Genuinely 24 hours</strong>
            <p>
              Not "24 hours" meaning an answering service until eight. A person
              picks up at 3 a.m. on a holiday, and a truck goes out.
            </p>
          </div>
        </li>
        <li>
          <Icon name="badge-check" size={20} />
          <div>
            <strong>OPP approved &amp; MTO licensed</strong>
            <p>
              Approved for police rotation calls, and holding Ministry of
              Transportation Vehicle Storage Certificate {business.storageCertificate}.
            </p>
          </div>
        </li>
        <li>
          <Icon name="map-pin" size={20} />
          <div>
            <strong>We know these roads</strong>
            <p>
              The 11 in a squall, the soft shoulders on the concessions in
              spring, the cottage lanes that stop being plowed in December.
            </p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================================================= FAQ -- -->
  <section class="section">
    <div class="wrap wrap-narrow">
      <FaqList
        faqs={generalFaqs}
        intro="The things people ask us most, answered plainly."
      />
    </div>
  </section>

  <!-- ========================================================= Contact -- -->
  <section class="section section-paper" id="contact">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Find us</p>
        <h2>123 Norweld Dr, Orillia</h2>
        <hr class="rule" />
        <p class="lede">
          Our yard and MTO-licensed storage are here in Orillia. Vehicles towed
          in town do not have to travel again to be stored.
        </p>

        <ul class="contact-list">
          <li>
            <Icon name="phone" size={20} />
            <a href={business.phoneHref}>{business.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={20} />
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </li>
          <li>
            <Icon name="map-pin" size={20} />
            <a href={business.mapsUrl} target="_blank" rel="noopener">{addressLine}</a>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <span>Open 24 hours, every day of the year</span>
          </li>
        </ul>

        <a href={url('/contact/')} class="btn btn-navy">
          Contact page
          <Icon name="arrow-right" size={19} />
        </a>
      </div>

      <div class="map-frame">
        <iframe
          src={business.mapsEmbed}
          title="Map showing Lakeside Towing & Recovery at 123 Norweld Dr, Orillia"
          width="600"
          height="450"
          style="border:0;width:100%;height:100%"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  /* ---------------------------------------------------------- hero ---- */

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(78svh, 720px);
    padding-block: clamp(3rem, 9vw, 5.5rem);
    overflow: hidden;
    background: var(--navy-deep);
  }

  .hero-img,
  .hero-img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  /* A narrow viewport sees a tall slice of a 16:9 photo. At the desktop focal
     point that slice lands on the customer's vehicle rather than ours, so pull
     it left onto the Lakeside truck and its lettering. */
  @media (max-width: 700px) {
    .hero-img,
    .hero-img img {
      object-position: 36% center;
    }
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(6 36 106 / 91%) 0%,
      rgb(6 36 106 / 78%) 38%,
      rgb(6 36 106 / 36%) 72%,
      rgb(6 36 106 / 18%) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    color: #fff;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .hero-badges li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.42rem 0.9rem;
    background: rgb(255 255 255 / 12%);
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .hero-badges .badge-red {
    background: var(--red);
    border-color: var(--red);
  }

  .hero h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    line-height: 0.95;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .h1-accent {
    color: var(--sky);
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.4vw, 1.9rem);
    font-style: italic;
    color: rgb(255 255 255 / 72%);
    margin-bottom: 1rem;
  }

  .hero-lede {
    max-width: 46ch;
    font-size: clamp(1rem, 2.1vw, 1.16rem);
    color: rgb(255 255 255 / 82%);
    margin-bottom: 1.9rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-call {
    font-size: clamp(1.42rem, 4.4vw, 2rem);
    min-height: 66px;
    padding-inline: 1.75rem;
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin: 1.6rem 0 0;
    font-size: 0.83rem;
    color: rgb(255 255 255 / 62%);
  }

  .hero-foot :global(.icon) {
    color: var(--sky);
  }

  /* --------------------------------------------------------- proof ---- */

  .proof {
    background: var(--navy);
    color: #fff;
  }

  .proof-inner {
    display: grid;
    gap: 1.1rem 2rem;
    padding-block: 1.6rem;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }

  .proof-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .proof-item :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--sky);
  }

  .proof-item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.16rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .proof-item span {
    font-size: 0.83rem;
    line-height: 1.45;
    color: rgb(255 255 255 / 68%);
  }

  /* --------------------------------------------------------- rates ---- */

  .rates-head {
    display: grid;
    gap: 2.25rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .rates-head {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
    }
  }

  /* --------------------------------------------------------- areas ---- */

  .area-cards {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .area-cards li {
    margin: 0;
  }

  .area-cards a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s, transform 0.18s;
  }

  .area-cards a:hover {
    border-color: var(--red);
    transform: translateY(-2px);
  }

  .area-cards a > :global(.icon:first-child) {
    flex: none;
    color: var(--red);
  }

  .area-cards div {
    flex: 1;
  }

  .area-cards strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--navy-deep);
  }

  .area-cards span {
    font-size: 0.86rem;
    color: var(--ink-soft);
  }

  .area-cards :global(.chev) {
    flex: none;
    color: var(--line);
  }

  .area-more {
    margin-top: 2.25rem;
    text-align: center;
  }

  .area-more > p {
    margin-bottom: 0.85rem;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .chips li {
    margin: 0;
    padding: 0.35rem 0.8rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .area-note {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-soft);
  }

  /* ----------------------------------------------------------- why ---- */

  .why-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .why-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
    }
  }

  .why-list {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .why-list li {
    display: flex;
    gap: 0.95rem;
    margin: 0;
  }

  .why-list :global(.icon) {
    flex: none;
    margin-top: 3px;
    padding: 9px;
    width: 42px;
    height: 42px;
    background: rgb(156 194 255 / 14%);
    border-radius: 10px;
    color: var(--sky);
    box-sizing: content-box;
  }

  .why-list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .why-list p {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 72%);
  }

  /* ------------------------------------------------------- contact ---- */

  .contact-grid {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .contact-list {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85rem;
    font-size: 1rem;
  }

  .contact-list :global(.icon) {
    flex: none;
    color: var(--red);
  }

  .contact-list a {
    color: var(--navy-deep);
    font-weight: 600;
    text-decoration: none;
    word-break: break-word;
  }

  .contact-list a:hover {
    color: var(--red);
    text-decoration: underline;
  }

  .map-frame {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
</style>
