---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, allCommunities, business, addressLine } from '../../data/site';
import { url, abs } from '../../lib/paths';

const title = 'Service Areas | Orillia, Rama, Gravenhurst & Barrie';
const description =
  'We cover Orillia, Rama, Washago, Gravenhurst, Barrie and the communities around Lake Couchiching — 24/7 towing, recovery and roadside assistance.';

const trail = [{ name: 'Service Areas', href: '/service-areas/' }];

const listSchema = {
  '@type': 'ItemList',
  name: 'Towing service areas',
  itemListElement: areas.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.name,
    url: abs(Astro.site!, `/service-areas/${a.slug}/`),
  })),
};

const others = allCommunities.filter((c) => !areas.some((a) => a.name === c));
---

<Layout title={title} description={description} breadcrumbs={trail} schema={[listSchema]}>
  <PageHero
    eyebrow="Coverage"
    title="Where we tow"
    lede="Our yard is on Norweld Dr in Orillia. From there we cover the city, the communities around Lake Couchiching, and the Highway 11 corridor north to Gravenhurst and south to Barrie."
    trail={trail}
    facts={['16 communities', 'Based in Orillia', '24/7 dispatch']}
    secondary={{ label: 'Our services', href: '/services/' }}
  />

  <section class="section">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">Main areas</p>
        <h2>Towns with a page of their own</h2>
        <hr class="rule" />
        <p class="lede">
          Local detail on each — the roads that generate calls, what the weather
          does, and how long it realistically takes us to get there.
        </p>
      </div>

      <ul class="area-list grid grid-2">
        {
          areas.map((a) => (
            <li>
              <a href={url(`/service-areas/${a.slug}/`)}>
                <div class="area-head">
                  <Icon name="map-pin" size={21} />
                  <h3>{a.name}</h3>
                </div>
                <p class="area-prox">{a.proximity}</p>
                <p class="area-intro">{a.intro}</p>
                <span class="area-more">
                  Towing in {a.name}
                  <Icon name="arrow-right" size={15} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-paper">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">Also covered</p>
        <h2>Communities around the lakes</h2>
        <hr class="rule" />
        <p class="lede">
          These are all inside our normal service area at normal rates. They are
          listed here rather than given pages of their own — a page per hamlet
          would say the same thing eleven times, which helps nobody.
        </p>
      </div>

      <ul class="chips">
        {
          others.map((c) => (
            <li>
              <Icon name="map-pin" size={14} />
              {c}
            </li>
          ))
        }
      </ul>

      <div class="not-listed">
        <Icon name="info" size={20} />
        <div>
          <strong>Not on the list?</strong>
          <p>
            Call and ask. We regularly run outside this list, particularly for
            long distance work, and we will tell you straight away whether we are
            the right truck for your job.
          </p>
          <a href={business.phoneHref} class="btn btn-primary">
            <Icon name="phone" size={19} />
            {business.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap map-grid">
      <div>
        <p class="eyebrow">Our base</p>
        <h2>Dispatching from Orillia</h2>
        <hr class="rule" />
        <p>
          Being local is not a marketing line, it is the difference between a
          45 minute wait and a two hour one. Our trucks and our MTO-licensed
          storage yard are both at {addressLine} — so a vehicle towed in Orillia
          does not have to travel again to be stored.
        </p>
        <p>
          Response times grow with distance, and we would rather tell you a
          realistic window than an optimistic one. In town, expect 30 to 45
          minutes. Washago and Rama add a little. Gravenhurst and Barrie add
          more. A snowstorm adds more again, for everybody.
        </p>
        <a href={url('/contact/')} class="btn btn-navy">
          Contact &amp; directions
          <Icon name="arrow-right" size={19} />
        </a>
      </div>
      <div class="map-frame">
        <iframe
          src={business.mapsEmbed}
          title="Map showing Lakeside Towing & Recovery at 123 Norweld Dr, Orillia"
          width="600"
          height="450"
          style="border:0;width:100%;height:100%"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<style>
  .area-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .area-list li {
    margin: 0;
  }

  .area-list a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.6rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s, transform 0.18s;
  }

  .area-list a:hover {
    border-color: var(--red);
    transform: translateY(-3px);
  }

  .area-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.25rem;
  }

  .area-head :global(.icon) {
    color: var(--red);
    flex: none;
  }

  .area-head h3 {
    margin: 0;
    font-size: 1.55rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--navy-deep);
  }

  .area-prox {
    margin: 0 0 0.7rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .area-intro {
    flex: 1;
    margin: 0 0 1.1rem;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .area-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0.45rem 0.95rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .chips :global(.icon) {
    color: var(--red);
  }

  .not-listed {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    max-width: 720px;
    margin: 2.5rem auto 0;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-left: 4px solid var(--red);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .not-listed > :global(.icon) {
    flex: none;
    margin-top: 3px;
    color: var(--red);
  }

  .not-listed strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.32rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--navy-deep);
    margin-bottom: 0.35rem;
  }

  .not-listed p {
    font-size: 0.94rem;
    color: var(--ink-soft);
  }

  .map-grid {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .map-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  .map-grid p {
    color: var(--ink-soft);
  }

  .map-frame {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
</style>
