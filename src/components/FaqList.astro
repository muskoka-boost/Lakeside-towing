---
interface Props {
  heading?: string;
  intro?: string;
  faqs: { q: string; a: string }[];
}

const { heading = 'Common questions', intro, faqs } = Astro.props;
---

<div class="faq">
  <h2>{heading}</h2>
  {intro && <p class="lede">{intro}</p>}
  <div class="faq-list">
    {
      faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <svg
              class="chev"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{f.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<style>
  .faq-list {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  details {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  details[open] {
    border-color: var(--sky);
    box-shadow: var(--shadow);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.25rem;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.24rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--navy-deep);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--red);
  }

  .chev {
    flex: none;
    color: var(--ink-faint);
    transition: transform 0.2s;
  }

  details[open] .chev {
    transform: rotate(180deg);
    color: var(--red);
  }

  .faq-answer {
    padding: 0 1.25rem 1.15rem;
  }

  .faq-answer p {
    margin: 0;
    color: var(--ink-soft);
    max-width: 72ch;
  }
</style>
