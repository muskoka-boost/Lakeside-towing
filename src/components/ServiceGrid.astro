---
import Icon from './Icon.astro';
import { services } from '../data/site';
import { url } from '../lib/paths';

interface Props {
  /** Restrict to these slugs, in order. Defaults to all services. */
  only?: string[];
  /** Slug to omit — used on service pages so a page never links to itself. */
  exclude?: string;
}

const { only, exclude } = Astro.props;

let list = only
  ? only.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean)
  : services;
if (exclude) list = list.filter((s) => s.slug !== exclude);
---

<ul class="service-grid grid grid-4">
  {
    list.map((s) => (
      <li class="service-card">
        <a href={url(`/services/${s.slug}/`)}>
          <span class="service-icon">
            <Icon name={s.icon as any} size={26} />
          </span>
          <h3>{s.name}</h3>
          <p>{s.summary}</p>
          <span class="service-more">
            Details
            <Icon name="arrow-right" size={15} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .service-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-card {
    margin: 0;
  }

  .service-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.18s, transform 0.18s, box-shadow 0.18s;
  }

  .service-card a:hover {
    border-color: var(--red);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    margin-bottom: 1rem;
    background: var(--sky-soft);
    border-radius: 12px;
    color: var(--navy);
    transition: background-color 0.18s, color 0.18s;
  }

  .service-card a:hover .service-icon {
    background: var(--red);
    color: #fff;
  }

  .service-card h3 {
    font-size: 1.32rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--navy-deep);
    margin-bottom: 0.35rem;
  }

  .service-card p {
    flex: 1;
    margin: 0 0 1rem;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .service-more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--red);
  }

  .service-card a:hover .service-more :global(.icon) {
    transform: translateX(3px);
  }

  .service-more :global(.icon) {
    transition: transform 0.18s;
  }
</style>
