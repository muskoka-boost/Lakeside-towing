---
/**
 * A real photograph, served responsively.
 *
 * Pulls everything but the layout from the `photos` registry in data/site.ts,
 * so alt text and dimensions live with the photo rather than being retyped at
 * each call site. Width and height are always emitted — the build verifier
 * rejects an <img> without them, because a photo that arrives without
 * reserved space shoves the page around as it loads.
 */
import { photoById } from '../data/site';
import { url } from '../lib/paths';

interface Props {
  /** Key into `photos` in data/site.ts. */
  id: string;
  /** Overrides the registry caption. Pass `false` to show none. */
  caption?: string | false;
  /** Rendered width hint for the browser's source selection. */
  sizes?: string;
  /** Above the fold, pass 'eager'. Everything else stays lazy. */
  loading?: 'lazy' | 'eager';
}

const {
  id,
  caption,
  sizes = '(max-width: 1100px) 100vw, 1040px',
  loading = 'lazy',
} = Astro.props;

const photo = photoById(id);
if (!photo) {
  throw new Error(
    `<Photo id="${id}"> — no such photo. Add it to \`photos\` in src/data/site.ts.`,
  );
}

const text = caption === false ? undefined : caption ?? photo.caption;
const src = (suffix = '') => url(`/media/${photo.file}${suffix}`);
---

<figure class="photo">
  <picture>
    <source media="(max-width: 700px)" srcset={src('-800.webp')} type="image/webp" />
    <source media="(max-width: 1100px)" srcset={src('-1280.webp')} type="image/webp" />
    <source srcset={src('.webp')} type="image/webp" />
    <img
      src={src('.jpg')}
      alt={photo.alt}
      width={photo.width}
      height={photo.height}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  </picture>
  {text && <figcaption>{text}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }

  .photo picture {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .photo figcaption {
    margin-top: 0.75rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--red);
    font-size: 0.89rem;
    line-height: 1.55;
    color: var(--ink-faint);
  }
</style>
